MEPER_IMAGE_TAG=0.1.0-20261013
MEPER_HTTP_PORT=8001

# 新安装：openssl rand -base64 32；复用已有控制库：必须填写原来的主密钥。
MEPER_MASTER_KEY=

# 必须连接 MySQL 控制库。容器内 localhost 指向后端自身；宿主机可用 host.docker.internal。
# 示例：jdbc:mysql://mysql-host:3306/meper_control?useUnicode=true&characterEncoding=utf8&sslMode=REQUIRED
# TLS 模式由管理员根据目标数据库配置显式选择。
MEPER_CONTROL_DB_URL=
MEPER_CONTROL_DB_USERNAME=
MEPER_CONTROL_DB_PASSWORD=

MEPER_BOOTSTRAP_ADMIN_USERNAME=admin
MEPER_BOOTSTRAP_ADMIN_PASSWORD=
