@@ -45,7 +45,8 @@ export class Runtime extends CompositionNode {
         this._trailingReject = null;
         this._previousDefinedType = null;
         this._onResize = debounce(() => {
-            this.forceFit();
+            // Ignore resize callbacks queued before the chart was unbound or destroyed.
+            if (this._hasBindAutoFit) this.forceFit();
         }, 300);
         this._renderer = renderer || new CanvasRenderer();
         this._plugins = plugins || [];
@@ -142,6 +143,18 @@ export class Runtime extends CompositionNode {
         this.emit(ChartEvent.AFTER_CLEAR);
     }
     destroy() {
+        // Like clear(), defer disposal until an in-flight render has settled.
+        this._unbindAutoFit();
+        // Cancel queued scene-graph animations before their targets are removed.
+        const cancelAnimations = (node) => {
+            node.getAnimations().forEach((animation) => animation.cancel());
+            node.children.forEach(cancelAnimations);
+        };
+        if (this._context.canvas) cancelAnimations(this._context.canvas.getRoot());
+        if (this._rendering) {
+            this._trailingClear = () => this.destroy();
+            return;
+        }
         const options = this.options();
         this.emit(ChartEvent.BEFORE_DESTROY);
         this._unbindAutoFit();
